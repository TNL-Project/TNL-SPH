{
    // === Control section ===
    // Simulation name, path to store results and path to read initial conditions
    "control": {
        "caseName": "damBreak3D_WCSPH-DBC",
        "outputDirectory": "results",
        "fluidParticles": "sources/dambreak_fluid.vtk",
        "boundaryParticles": "sources/dambreak_boundary.vtk",

        // Simulation end time, output interval, output intensity
        "finalTime": 7.0,
        "snapshotPeriod": 0.1,
        "verboseIntensity": "with-snapshot"
    },

    // === Particle system configuration ===
    "particles": {
        "numberOfParticles": placeholderFluidParticles,
        "numberOfAllocatedParticles": placeholderAllocatedFluidParticles,
        "numberOfBoundaryParticles": placeholderBoundaryParticles,
        "numberOfAllocatedBoundaryParticles": placeholderAllocatedBoundaryParticles
    },

    // === Domain size and domain origin ===
    "domain": {
        "searchRadius": placeholderSearchRadius,
        "domainOrigin-x": placeholderDomainOrigin-x,
        "domainOrigin-y": placeholderDomainOrigin-y,
        "domainOrigin-z": placeholderDomainOrigin-z,
        "domainSize-x": placeholderDomainSize-x,
        "domainSize-y": placeholderDomainSize-y,
        "domainSize-z": placeholderDomainSize-z
    },

    // === SPH solver section - resolution parameters ===
    "model": {
        // initial particle distance - dp [m]
        "dp": placeholderInitParticleDistance,
        // smoothing length - h [m]
        "h": placeholderSmoothingLength,
        // particle mass - mass [kg]
        "mass": placeholderMass,

        // === Medium properties and model constants ===
        // referential density of medium - rho0 [kg/m^3]
        "rho0": placeholderDensity,
        // delta-WCSPH diffusive term coefficient - delta [-]
        "delta": 0.1,
        // NOTE: Here, we define coef. both for artificial viscosity. Based on the selected
        // model, only one of them is actually used
        // artificial vicosity coefficient - alpha [-]
        "alpha": placeholderAlpha,
        // dynamic viscosity coefficient - alpha [Pa/s]
        "dynamicViscosity": placeholderDynamicViscosity,
        // EOS parameters - numerical speed of sound - c0 [m/s]
        "speedOfSound": placeholderSpeedOfSound,
        // prevent zero denominator constant
        "eps": 0.001,
        // external force [m/s^2]
        "externalForce-x": 0,
        "externalForce-y": 0,
        "externalForce-z": -9.81
    },

    // === SPH solver section - integration parameters ===
    "integration": {
        // initial time step [s]
        "initialTimeStep": placeholderTimeStep,
        "CFL": placeholderCFL
    },

    // === Measure tool initialization section ===
    "interpolationPlanesCount": 1,
    "pressureSensorsCount": 8,
    "waterLevelSensorsCount": 4,

    // Inline measuretool config (alternative to "measuretoolConfig" file path).
    // When "measuretoolConfig" is empty, the solver reads this subsection instead.
    "measuretool": {
        // === Interpolation grid ===
        "plane1Identifier": "interpolation",
        "plane1OutputTime": 0.05,
        "plane1GridOrigin-x": 0,
        "plane1GridOrigin-y": 0.5,
        "plane1GridOrigin-z": 0,
        "plane1GridSize-x": 321,
        "plane1GridSize-y": 1,
        "plane1GridSize-z": 80,
        "plane1GridStep-x": 0.01,
        "plane1GridStep-y": 0.01,
        "plane1GridStep-z": 0.01,

        // === Measure pressure - points ===
        "sensorPOutputTime": 2e-3,
        "sensorPIncludeBoundary": true,
        // Point 1
        "sensorPPoint1-x": 0.8245,
        "sensorPPoint1-y": 0.471,
        "sensorPPoint1-z": 0.021,
        // Point 2
        "sensorPPoint2-x": 0.8245,
        "sensorPPoint2-y": 0.471,
        "sensorPPoint2-z": 0.061,
        // Point 3
        "sensorPPoint3-x": 0.8245,
        "sensorPPoint3-y": 0.471,
        "sensorPPoint3-z": 0.101,
        // Point 4
        "sensorPPoint4-x": 0.8245,
        "sensorPPoint4-y": 0.471,
        "sensorPPoint4-z": 0.141,
        // Point 5
        "sensorPPoint5-x": 0.8035,
        "sensorPPoint5-y": 0.471,
        "sensorPPoint5-z": 0.161,
        // Point 6
        "sensorPPoint6-x": 0.7635,
        "sensorPPoint6-y": 0.471,
        "sensorPPoint6-z": 0.161,
        // Point 7
        "sensorPPoint7-x": 0.7235,
        "sensorPPoint7-y": 0.471,
        "sensorPPoint7-z": 0.161,
        // Point 8
        "sensorPPoint8-x": 0.6835,
        "sensorPPoint8-y": 0.471,
        "sensorPPoint8-z": 0.161,

        // === Measure water level - points ===
        "sensorWlOutputTime": 2e-3,
        "sensorWlStartLevel": 0,
        "sensorWlEndLevel": 0.6,
        "sensorWlLevelIncrement": 0.005,
        "sensorWlDirection-x": 0,
        "sensorWlDirection-y": 0,
        "sensorWlDirection-z": 1,
        // Point 1
        "sensorWlPoint1-x": 0.496,
        "sensorWlPoint1-y": 0.5,
        "sensorWlPoint1-z": 0.0028284,
        // Point 2
        "sensorWlPoint2-x": 0.992,
        "sensorWlPoint2-y": 0.5,
        "sensorWlPoint2-z": 0.0028284,
        // Point 3
        "sensorWlPoint3-x": 1.488,
        "sensorWlPoint3-y": 0.5,
        "sensorWlPoint3-z": 0.0028284,
        // Point 4
        "sensorWlPoint4-x": 2.638,
        "sensorWlPoint4-y": 0.5,
        "sensorWlPoint4-z": 0.0028284
    }
}
