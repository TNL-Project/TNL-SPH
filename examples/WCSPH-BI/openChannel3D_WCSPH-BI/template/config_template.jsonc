{
    // === Control section ===
    // Simulation name, path to store results and path to read initial conditions
    "control": {
        "caseName": "openChannel3D_WCSPH-BI",
        "outputDirectory": "results",
        "fluidParticles": "sources/openchannel_fluid.vtk",
        "boundaryParticles": "sources/openchannel_boundary.vtk",

        // Simulation end time, output interval, output intensity
        "finalTime": 2.5,
        "snapshotPeriod": 0.05,
        "verboseIntensity": "with-snapshot"
    },

    // Particle system configuration
    "particles": {
        "numberOfParticles": placeholderFluidParticles,
        "numberOfAllocatedParticles": placeholderAllocatedFluidParticles,
        "numberOfBoundaryParticles": placeholderBoundaryParticles,
        "numberOfAllocatedBoundaryParticles": placeholderAllocatedBoundaryParticles
    },

    // Domain size and domain origin
    "domain": {
        "searchRadius": placeholderSearchRadius,
        "domainOrigin-x": placeholderDomainOrigin-x,
        "domainOrigin-y": placeholderDomainOrigin-y,
        "domainOrigin-z": placeholderDomainOrigin-z,
        "domainSize-x": placeholderDomainSize-x,
        "domainSize-y": placeholderDomainSize-y,
        "domainSize-z": placeholderDomainSize-z
    },

    // === SPH solver section - resolution parameters ===
    "model": {
        // initial particle distance - dp [m]
        "dp": placeholderInitParticleDistance,
        // smoothing length - h [m]
        "h": placeholderSmoothingLength,
        // particle mass - mass [kg]
        "mass": placeholderMass,
        // size of boundary element - boundaryElementSize [m]
        "boundaryElementSize": placeholderBoundaryElementSize,

        // === Medium properties and model constants ===
        // referential density of medium - rho0 [kg/m^3]
        "rho0": placeholderDensity,
        // delta-WCSPH diffusive term coefficient - delta [-]
        "delta": 0.1,
        // artificial viscosity coefficient - alpha [-]
        "alpha": 0.02,
        // EOS parameters - numerical speed of sound - c0 [m/s]
        "speedOfSound": placeholderSpeedOfSound,
        // prevent zero denominator constant
        "eps": 0.001,
        // external force [m/s^2]
        "externalForce-x": 0,
        "externalForce-y": 0,
        "externalForce-z": -9.81
    },

    // === SPH solver section - integration parameters ===
    "integration": {
        // initial time step [s]
        "initialTimeStep": placeholderTimeStep
    },

    // Inlet and outlet boundary conditions
    "openBoundaryPatches": 2,

    // Inline open boundary config (alternative to "openBoundaryConfig" file path).
    // When "openBoundaryConfig" is empty, the solver reads this subsection instead.
    "openBoundary": {
        // === Buffer 1 - inlet ===
        "buffer1Particles": "sources/openchannel_inlet.vtk",
        "buffer1NumberOfParticles": placeholderInletParticles,
        "buffer1NumberOfAllocatedParticles": placeholderAllocatedInletParticles,
        "buffer1Type": "inlet",
        "buffer1Identifier": "inlet",
        "buffer1Orientation-x": 1.0,
        "buffer1Orientation-y": 0.0,
        "buffer1Orientation-z": 0.0,
        "buffer1Position1-x": placeholderInletPosition1_x,
        "buffer1Position1-y": placeholderInletPosition1_y,
        "buffer1Position1-z": placeholderInletPosition1_z,
        "buffer1Position2-x": placeholderInletPosition2_x,
        "buffer1Position2-y": placeholderInletPosition2_y,
        "buffer1Position2-z": placeholderInletPosition2_z,
        "buffer1BufferWidth-x": placeholderInletWidth_x,
        "buffer1BufferWidth-y": 0.0,
        "buffer1BufferWidth-z": 0.0,
        "buffer1Rho_bc": "fixed",
        "buffer1Density": placeholderInletDensity,
        "buffer1V_bc": "fixed",
        "buffer1Velocity-x": placeholderInletVelocity_x,
        "buffer1Velocity-y": placeholderInletVelocity_y,
        "buffer1Velocity-z": placeholderInletVelocity_z,

        // === Buffer 2 - outlet ===
        "buffer2Particles": "sources/openchannel_outlet.vtk",
        "buffer2NumberOfParticles": placeholderOutletParticles,
        "buffer2NumberOfAllocatedParticles": placeholderAllocatedOutletParticles,
        "buffer2Type": "outlet",
        "buffer2Identifier": "outlet",
        "buffer2Orientation-x": -1.0,
        "buffer2Orientation-y": 0.0,
        "buffer2Orientation-z": 0.0,
        "buffer2Position1-x": placeholderOutletPosition1_x,
        "buffer2Position1-y": placeholderOutletPosition1_y,
        "buffer2Position1-z": placeholderOutletPosition1_z,
        "buffer2Position2-x": placeholderOutletPosition2_x,
        "buffer2Position2-y": placeholderOutletPosition2_y,
        "buffer2Position2-z": placeholderOutletPosition2_z,
        "buffer2BufferWidth-x": placeholderOutletWidth_x,
        "buffer2BufferWidth-y": 0.0,
        "buffer2BufferWidth-z": 0.0,
        "buffer2Rho_bc": "extrapolated",
        "buffer2Density": placeholderOutletDensity,
        "buffer2V_bc": "extrapolated",
        "buffer2Velocity-x": placeholderOutletVelocity_x,
        "buffer2Velocity-y": placeholderOutletVelocity_y,
        "buffer2Velocity-z": placeholderOutletVelocity_z,
        "buffer2ExtrapolationDetTreshold": 1e3
    }
}
