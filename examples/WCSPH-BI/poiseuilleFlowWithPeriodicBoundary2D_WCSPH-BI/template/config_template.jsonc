{
    // === Control section ===
    "caseName": "poiseuilleFlowWithPeriodicBoundary2D_WCSPH-BI",
    "outputDirectory": "results",
    "fluidParticles": "sources/openchannel_fluid.vtk",
    "boundaryParticles": "sources/openchannel_boundary.vtk",
    "finalTime": 2.5,
    "snapshotPeriod": 0.05,
    "verboseIntensity": "with-snapshot",

    // === Particle system configuration ===
    "numberOfParticles": placeholderFluidParticles,
    "numberOfAllocatedParticles": placeholderAllocatedFluidParticles,
    "numberOfBoundaryParticles": placeholderBoundaryParticles,
    "numberOfAllocatedBoundaryParticles": placeholderAllocatedBoundaryParticles,

    // === Domain ===
    "searchRadius": placeholderSearchRadius,
    "domainOriginX": placeholderDomainOrigin-x,
    "domainOriginY": placeholderDomainOrigin-y,
    "domainSizeX": placeholderDomainSize-x,
    "domainSizeY": placeholderDomainSize-y,

    // === Model parameters ===
    "dp": placeholderInitParticleDistance,
    "h": placeholderSmoothingLength,
    "mass": placeholderMass,
    "rho0": placeholderDensity,
    "delta": 0.1,
    "alpha": 0.02,
    "dynamicViscosity": 0.001,
    "speedOfSound": placeholderSpeedOfSound,
    "eps": 0.001,
    "externalForceX": 0.1,
    "externalForceY": 0,

    // === Integration ===
    "initialTimeStep": placeholderTimeStep,

    // === Periodic boundary patches ===
    "periodicBoundaryPatches": 2,

    // Inline periodic boundary config (alternative to "periodicBoundaryConfig" file path).
    "periodicBoundary": {
        // === Buffer 1 - left periodic boundary ===
        "buffer1Type": "periodic",
        "buffer1PairedPeriodicBuffer": 2,
        "buffer1Particles": "sources/openchannel_periodicityLeft.vtk",
        "buffer1NumberOfParticles": placeholderPeriodicityLeftParticles,
        "buffer1NumberOfAllocatedParticles": placeholderPeriodicityLeftAllocatedParticles,
        "buffer1Identifier": "periodicityLeft",
        "buffer1OrientationX": 1.0,
        "buffer1OrientationY": 0.0,
        "buffer1Position1X": placeholderInletPosition1_x,
        "buffer1Position1Y": placeholderInletPosition1_y,
        "buffer1Position2X": placeholderInletPosition2_x,
        "buffer1Position2Y": placeholderInletPosition2_y,
        "buffer1BufferWidthX": placeholderInletWidth_x,
        "buffer1BufferWidthY": 0.0,
        "buffer1ShiftVectorX": placeholderInletShiftVector_x,
        "buffer1ShiftVectorY": 0.0,

        // === Buffer 2 - right periodic boundary ===
        "buffer2Type": "periodic",
        "buffer2PairedPeriodicBuffer": 1,
        "buffer2Particles": "sources/openchannel_periodicityRight.vtk",
        "buffer2NumberOfParticles": placeholderPeriodicityRightParticles,
        "buffer2NumberOfAllocatedParticles": placeholderPeriodicityRightAllocatedParticles,
        "buffer2Identifier": "periodicityRight",
        "buffer2OrientationX": -1.0,
        "buffer2OrientationY": 0.0,
        "buffer2Position1X": placeholderOutletPosition1_x,
        "buffer2Position1Y": placeholderOutletPosition1_y,
        "buffer2Position2X": placeholderOutletPosition2_x,
        "buffer2Position2Y": placeholderOutletPosition2_y,
        "buffer2BufferWidthX": placeholderOutletWidth_x,
        "buffer2BufferWidthY": 0.0,
        "buffer2ShiftVectorX": placeholderOutletShiftVector_x,
        "buffer2ShiftVectorY": 0.0
    }
}
