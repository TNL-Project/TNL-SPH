{
    // === Control section ===
    "caseName": "poiseuilleFlowWithPeriodicBoundary2D_WCSPH-BI",
    "outputDirectory": "results",
    "fluidParticles": "sources/openchannel_fluid.vtk",
    "boundaryParticles": "sources/openchannel_boundary.vtk",
    "finalTime": 2.5,
    "snapshotPeriod": 0.05,
    "verboseIntensity": "with-snapshot",

    // === Particle system configuration ===
    "numberOfParticles": placeholderFluidParticles,
    "numberOfAllocatedParticles": placeholderAllocatedFluidParticles,
    "numberOfBoundaryParticles": placeholderBoundaryParticles,
    "numberOfAllocatedBoundaryParticles": placeholderAllocatedBoundaryParticles,

    // === Domain ===
    "searchRadius": placeholderSearchRadius,
    "domainOrigin-x": placeholderDomainOrigin-x,
    "domainOrigin-y": placeholderDomainOrigin-y,
    "domainSize-x": placeholderDomainSize-x,
    "domainSize-y": placeholderDomainSize-y,

    // === Model parameters ===
    "dp": placeholderInitParticleDistance,
    "h": placeholderSmoothingLength,
    "mass": placeholderMass,
    "rho0": placeholderDensity,
    "delta": 0.1,
    "alpha": 0.02,
    "dynamicViscosity": 0.001,
    "speedOfSound": placeholderSpeedOfSound,
    "eps": 0.001,
    "externalForce-x": 0.1,
    "externalForce-y": 0,

    // === Integration ===
    "initialTimeStep": placeholderTimeStep,

    // === Periodic boundary patches ===
    "periodicBoundaryPatches": 2,

    // Inline periodic boundary config (alternative to "periodicBoundaryConfig" file path).
    "periodicBoundary": {
        "buffers": {
            "buffer1": {
                // === Buffer 1 - left periodic boundary ===
                "type": "periodic",
                "pairedPeriodicBuffer": 2,
                "particles": "sources/openchannel_periodicityLeft.vtk",
                "numberOfParticles": placeholderPeriodicityLeftParticles,
                "numberOfAllocatedParticles": placeholderPeriodicityLeftAllocatedParticles,
                "identifier": "periodicityLeft",
                "orientation-x": 1.0,
                "orientation-y": 0.0,
                "position1-x": placeholderInletPosition1_x,
                "position1-y": placeholderInletPosition1_y,
                "position2-x": placeholderInletPosition2_x,
                "position2-y": placeholderInletPosition2_y,
                "bufferWidth-x": placeholderInletWidth_x,
                "bufferWidth-y": 0.0,
                "shiftVector-x": placeholderInletShiftVector_x,
                "shiftVector-y": 0.0
            },

            "buffer2": {
                // === Buffer 2 - right periodic boundary ===
                "type": "periodic",
                "pairedPeriodicBuffer": 1,
                "particles": "sources/openchannel_periodicityRight.vtk",
                "numberOfParticles": placeholderPeriodicityRightParticles,
                "numberOfAllocatedParticles": placeholderPeriodicityRightAllocatedParticles,
                "identifier": "periodicityRight",
                "orientation-x": -1.0,
                "orientation-y": 0.0,
                "position1-x": placeholderOutletPosition1_x,
                "position1-y": placeholderOutletPosition1_y,
                "position2-x": placeholderOutletPosition2_x,
                "position2-y": placeholderOutletPosition2_y,
                "bufferWidth-x": placeholderOutletWidth_x,
                "bufferWidth-y": 0.0,
                "shiftVector-x": placeholderOutletShiftVector_x,
                "shiftVector-y": 0.0
            }
        }
    }
}
